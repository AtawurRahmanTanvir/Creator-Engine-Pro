{
  "name": "creator-engine-pro",
  "version": "1.0.0",
  "description": "Premium AI Automation Workspace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win -p always",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Atawur Rahman",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/AtawurRahmanTanvir/Creator-Engine-Pro.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.atawur.creatorenginepro",
    "productName": "Creator Engine Pro",
    "compression": "normal",
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "AtawurRahmanTanvir",
        "repo": "Creator-Engine-Pro"
      }
    ],
    "files": [
      "**/*",
      "!Accounts",
      "!Master_Controller/Inbox",
      "!Master_Controller/Outbox",
      "!Master_Controller/Final_Reports"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "createDesktopShortcut": true
    }
  }
}